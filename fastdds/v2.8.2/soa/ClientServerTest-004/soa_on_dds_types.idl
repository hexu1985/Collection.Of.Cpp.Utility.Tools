
module soa_on_dds {

enum ErrorCode {
    SUCCESS,
    OTHER_ERROR, 
    SERIALIZE_FAILED,
    DESERIALIZE_FAILED,
    SERVICE_NOT_AVAILABLE,
    METHOD_NOT_REGISTER,
    REQUEST_TIMEOUT
};

struct RPC_Header {
    string method_name;
    string client_id;
    long session_id;
    long request_id;
};

struct RPC_Request {
    RPC_Header header;
    sequence<octet> request_payload;
};

struct RPC_Response {
    RPC_Header header;
    ErrorCode error_code;
    sequence<octet> response_payload;
};

};  // soa_on_dds
